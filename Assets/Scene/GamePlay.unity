  levelsTasks:
  - levelNO: Night 1
    missionName: "Who\u2019s at the Door?"
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 1
      description: -Answer the ringing doorbell and find the baby.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 8
      description: -Pick up the baby and settle it in Bedroom.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 2
    missionName: The Baby is Hungry
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 2
      description: -Find the Feeder in the Kitchen.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 11
      description: -Feed the baby.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 3
    missionName: Something Feels Wrong
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 19
      description: -Pick up the baby and take it to the washroom.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 20
      description: "-Find the facewash and clean the baby\u2019s face."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 4
    missionName: Cold Whispers
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 3
      description: -Find warm clothes for the baby.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 12
      description: "-Change the baby\u2019s clothes."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 5
    missionName: "The Baby\u2019s Silent Tears"
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 21
      description: -Find a toy to cheer up the baby.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 22
      description: -Give the toy to the baby.
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 6
    missionName: Vanishing Baby
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 23
      description: "-The baby is crying\u2014check the baby\u2019s Bedroom."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 8
      description: "-The baby is hiding\u2014find it and put it back to bed."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 7
    missionName: Smoke in the Air
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 6
      description: -Find the fire extinguisher
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 24
      description: "-Put out the fire\u2026 but who started it?"
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 8
    missionName: Trapped Baby.
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 15
      description: "-Check the baby\u2019s Bedroom."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 25
      description: "-The Bed door won\u2019t open, find an axe and break the door."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
    - isCompleted: 0
      requireLevel: -1
      taskType: 14
      description: -Pick up the baby and leave the room
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 9
    missionName: "The Baby\u2019s Voice"
    taskInfos:
    - isCompleted: 0
      requireLevel: -1
      taskType: 26
      description: "-Follow the baby\u2019s voice."
      OnComplete:
        m_PersistentCalls:
          m_Calls: []
  - levelNO: Night 10
